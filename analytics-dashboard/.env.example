# MongoDB connection URI (shared database with voice-engine)
MONGO_URI=mongodb://localhost:27017/voice-agent-telemetry

# NextAuth configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-super-secret-random-key-here

# Voice Engine URL
# Local dev (outside Docker): http://localhost:5050
# Docker Compose dev: http://voice-engine:5050
VOICE_ENGINE_URL=http://localhost:5050

# Razorpay API Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id    #optional
RAZORPAY_KEY_SECRET=your_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
